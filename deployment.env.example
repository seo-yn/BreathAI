# API and worker: same persistent root; local filesystem, one worker per GPU.
TTOBAGI_JOB_ROOT=/data/jobs
# BE -> AI: configure the same value on both sides.
TTOBAGI_AI_API_TOKEN=
# AI -> BE: configure the same value on both sides.
TTOBAGI_CALLBACK_TOKEN=
TTOBAGI_BE_BASE_URL=https://backend.example.com
# BE setting: actual external Vast.ai endpoint or private tunnel endpoint.
TTOBAGI_AI_SERVER=https://ai.example.com
# FAQ sources and existing DB_* settings are also required by inference.
TTOBAGI_GENERAL_FAQ_PATH=/data/sources/일반상담.xlsx
TTOBAGI_COUNSELLING_FAQ_PATH=/data/sources/counselling_info.csv
# Existing inference DB configuration: approved FAQ reads still require DB access.
DB_HOST=
DB_PORT=3306
DB_NAME=ttobagi_db
DB_USER=
DB_PASSWORD=
# Compose variables (used for substitution via --env-file .env.ai).
# Use an absolute directory containing FAQ source files.
AI_SOURCE_DIR=/absolute/path/to/faq-sources
AI_BIND_ADDRESS=127.0.0.1
AI_PORT=8000
